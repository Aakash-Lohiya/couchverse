# Copy to .env (or set these in your hosting dashboard)

# Port the server listens on (hosting platforms usually set this for you)
PORT=4000

# Long random string used to sign session tokens. REQUIRED in production.
JWT_SECRET=change-me-to-a-long-random-string

# Google Sign-In: Web client id from Google Cloud Console (optional).
# Add your site origin (e.g. https://couchverse.onrender.com) under
# "Authorized JavaScript origins" for that client.
GOOGLE_CLIENT_ID=

# Email-based dev login. Defaults to true when GOOGLE_CLIENT_ID is empty.
# Set to false on a public site once Google Sign-In is configured.
ALLOW_DEV_LOGIN=true

# Public URL of the site. Baked into the extension so its bridge script
# runs on your domain (used by `npm run build:ext` / `npm run build`).
SITE_ORIGIN=http://localhost:5173

# Chrome Web Store listing (optional). When set, the site shows "Add to Chrome".
EXTENSION_STORE_URL=

# SQLite location (optional). On hosts with a persistent disk, point this at it.
DB_PATH=
